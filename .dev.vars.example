# Copy to ignored .dev.vars for local configuration; replace every placeholder.
# No production keys are generated by the application.
ORIGIN="http://127.0.0.1:8790"
DISCORD_CLIENT_ID="<Discord application ID>"
DISCORD_CLIENT_SECRET="<Discord application secret>"
# Optional. Enable Activities with the bot token for the same application.
# DISCORD_ACTIVITY_BOT_TOKEN="<Discord bot token>"
SESSION_SECRET="<canonical base64url of 32 random bytes>"
MINT_ID="<permanent canonical base64url of 16 random bytes>"
MINT_KEY_ID="mint-1"
MINT_PUBLIC_KEYS='{"mint-1":"<Ed25519 public JWK x>"}'
MINT_PRIVATE_KEYS='{"mint-1":{"kty":"OKP","crv":"Ed25519","x":"<public JWK x>","d":"<private JWK d>"}}'
BATCH_SIZE="1000"
LIFETIME_MINT_LIMIT="0"
